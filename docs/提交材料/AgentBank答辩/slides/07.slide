<Slide style={{ padding: 60, background: '#0F172A' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 22 }}>
    <Box style={{ width: 6, height: 28, background: '#6366F1', borderRadius: 3 }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#F1F5F9' }}>防线二 · P0–P3 权限分级</Text>
  </Box>
  <Box style={{ width: '100%', height: 1, background: '#334155', marginBottom: 16 }} />
  <Box style={{ background: '#1E293B', border: '1px solid #334155', borderRadius: 12, overflow: 'hidden' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '14px 24px', background: '#0B1120' }}>
      <Box style={{ width: 130 }}><Text style={{ fontSize: 16, color: '#64748B', fontWeight: 'bold' }}>级别</Text></Box>
      <Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#64748B', fontWeight: 'bold' }}>例子</Text></Box>
      <Box style={{ width: 300 }}><Text style={{ fontSize: 16, color: '#64748B', fontWeight: 'bold' }}>智能体</Text></Box>
    </Box>
    {[
      { lv: 'P0', name: '只读', ex: '查余额、查账单', act: '直接答', color: '#334155' },
      { lv: 'P1', name: '低敏写', ex: '定时转账、取消订阅', act: '申请 + 一次确认', color: '#334155' },
      { lv: 'P2', name: '资金', ex: '转账、申购、挂失、锁资', act: '申请 + 支付密码 + 短信', color: '#6366F1' },
      { lv: 'P3', name: '高危', ex: '解绑卡、改支付密码、解绑手机', act: '永久无权', color: '#EF4444' },
    ].map((r, i) => (
      <Box key={i}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '16px 24px' }}>
          <Box style={{ width: 130, flexDirection: 'row', alignItems: 'center', gap: 10 }}>
            <Box style={{ background: r.color, borderRadius: 8, padding: '6px 12px' }}>
              <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#FFFFFF' }}>{r.lv}</Text>
            </Box>
            <Text style={{ fontSize: 16, color: '#E2E8F0' }}>{r.name}</Text>
          </Box>
          <Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: '#CBD5E1' }}>{r.ex}</Text></Box>
          <Box style={{ width: 300 }}><Text style={{ fontSize: 17, color: r.color === '#EF4444' ? '#F87171' : '#A5B4FC', fontWeight: 'bold' }}>{r.act}</Text></Box>
        </Box>
        {i < 3 && <Box style={{ width: '100%', height: 1, background: '#334155' }} />}
      </Box>
    ))}
  </Box>
  <Box style={{ background: '#1E293B', borderLeft: '4px solid #6366F1', borderRadius: 8, padding: '18px 24px', marginTop: 22 }}>
    <Text style={{ fontSize: 18, color: '#CBD5E1' }}>
      <Text style={{ color: '#A5B4FC', fontWeight: 'bold' }}>P3 不是「暂不支持」，是产品结论</Text>——解绑卡交给可能被注入的链路，等于把最高危权限外包给模型。
    </Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, left: 60 }}>
    <Text style={{ fontSize: 14, color: '#475569' }}>AgentBank · 智能体银行</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#475569' }}>07 / 18</Text>
  </Box>
</Slide>
