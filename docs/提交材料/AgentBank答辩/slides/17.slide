  <Box style={{ width: '100%', height: 1, background: '#334155', marginBottom: 28 }} />
  <Box style={{ flexDirection: 'row', gap: 20, marginBottom: 30 }}>
    {[
      { t: 'H5 完整', d: '6 个页面无白屏' },
      { t: '安全驾驶舱', d: '真实数字非手填' },
      { t: '投屏演示模式', d: '字号放大 3 米可读' },
      { t: '黄金轨迹', d: '断网可回放 7 条', hot: true },
    ].map((it, i) => (
      <Box key={i} style={{ flex: 1, background: it.hot ? '#1E2A5E' : '#1E293B', border: it.hot ? '1px solid #6366F1' : '1px solid #334155', borderRadius: 12, padding: '22px 24px' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: it.hot ? '#A5B4FC' : '#F1F5F9', marginBottom: 12 }}>{it.t}</Text>
