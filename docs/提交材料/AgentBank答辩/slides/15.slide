<Slide style={{ padding: 60, background: '#0F172A' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 22 }}>
    <Box style={{ width: 6, height: 28, background: '#6366F1', borderRadius: 3 }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#F1F5F9' }}>实测数据（全部可复跑）</Text>
  </Box>
  <Box style={{ width: '100%', height: 1, background: '#334155', marginBottom: 16 }} />
  <Box style={{ background: '#1E293B', border: '1px solid #334155', borderRadius: 12, overflow: 'hidden' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '14px 24px', background: '#0B1120' }}>
      <Box style={{ width: 360 }}><Text style={{ fontSize: 16, color: '#64748B', fontWeight: 'bold' }}>套件</Text></Box>
      <Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#64748B', fontWeight: 'bold' }}>结果</Text></Box>
    </Box>
    {[
      { l: '注入攻击', r: '70/70 + 25/25 无误伤', hot: false },
      { l: '安全加固', r: '28/28', hot: false },
      { l: '并发竞态', r: '6/6（资金净变动 ¥0.00）', hot: false },
      { l: '冒烟', r: '9/9', hot: false },
      { l: '订阅+跨场景 / 挂失+自主 / 上下文 / 产品', r: '30 / 30 / 12 / 16', hot: false },
      { l: '质量', r: 'D1 100% · D2 0%', hot: false },
      { l: '综合核查', r: '37 PASS / 0 PARTIAL / 0 FAIL', hot: true },
    ].map((it, i) => (
      <Box key={i}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '13px 24px', background: it.hot ? '#1E2A5E' : 'transparent' }}>
          <Box style={{ width: 360 }}><Text style={{ fontSize: 17, color: it.hot ? '#A5B4FC' : '#E2E8F0', fontWeight: it.hot ? 'bold' : 'normal' }}>{it.l}</Text></Box>
          <Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: it.hot ? '#A5B4FC' : '#CBD5E1', fontWeight: it.hot ? 'bold' : 'normal' }}>{it.r}</Text></Box>
        </Box>
        {i < 6 && <Box style={{ width: '100%', height: 1, background: '#334155' }} />}
      </Box>
    ))}
  </Box>
  <Text style={{ fontSize: 15, color: '#64748B', marginTop: 18 }}>用例总量约 250 条（门槛 108）——这些数字不是手填的，是脚本跑出来的，仓库里可以复跑。</Text>
  <Box style={{ position: 'absolute', bottom: 26, left: 60 }}>
    <Text style={{ fontSize: 14, color: '#475569' }}>AgentBank · 智能体银行</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#475569' }}>15 / 18</Text>
  </Box>
</Slide>
