      </Box>
      <Box style={{ width: 1, height: 46, background: '#334155' }} />
      <Text style={{ fontSize: 18, color: '#CBD5E1', flex: 1, lineHeight: 1.5 }}>数据隔离 / 权限 / schema / <Text style={{ color: '#A5B4FC', fontWeight: 'bold' }}>指纹</Text> / 限速 / <Text style={{ color: '#A5B4FC', fontWeight: 'bold' }}>审计链</Text></Text>
