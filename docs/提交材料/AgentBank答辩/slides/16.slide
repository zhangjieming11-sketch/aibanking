<Slide style={{ padding: 60, background: '#0F172A' }}>
  <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 22 }}>
    <Box style={{ width: 6, height: 28, background: '#6366F1', borderRadius: 3 }} />
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#F1F5F9' }}>诚实的部分：已知限制</Text>
  </Box>
  <Box style={{ width: '100%', height: 1, background: '#334155', marginBottom: 16 }} />
  <Box style={{ background: '#1E293B', border: '1px solid #334155', borderRadius: 12, overflow: 'hidden' }}>
    <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '14px 24px', background: '#0B1120' }}>
      <Box style={{ flex: 1 }}><Text style={{ fontSize: 16, color: '#64748B', fontWeight: 'bold' }}>限制</Text></Box>
      <Box style={{ width: 380 }}><Text style={{ fontSize: 16, color: '#64748B', fontWeight: 'bold' }}>原因 / 取舍</Text></Box>
    </Box>
    {[
      { l: '忘记支付密码已支持本人人脸 + 短信双因子重置（P3 本人通道，Agent 不可触达；非生产级仍须人工核验兜底）', r: '演示环境靠 reset，正式需人工核验' },
      { l: '限速与锁在进程内', r: '单实例演示足够，多实例需 Redis' },
      { l: '会话历史不落库', r: '刷新后只有草稿恢复，不是完整续接' },
      { l: 'A6 生日惊喜偏演示性', r: '真实需求存疑，做它是为了题眼' },
      { l: '无障碍与适老化未做', r: 'M1–M5 都假设用户能读卡片、能打字' },
    ].map((it, i) => (
      <Box key={i}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', padding: '16px 24px' }}>
          <Box style={{ flex: 1 }}><Text style={{ fontSize: 17, color: '#E2E8F0', lineHeight: 1.5 }}>{it.l}</Text></Box>
          <Box style={{ width: 380 }}><Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.5 }}>{it.r}</Text></Box>
        </Box>
        {i < 4 && <Box style={{ width: '100%', height: 1, background: '#334155' }} />}
      </Box>
    ))}
  </Box>
  <Text style={{ fontSize: 15, color: '#64748B', marginTop: 18 }}>说限制要给出「为什么这么取舍」，而不是「没来得及做」——前者是工程判断，后者是欠债。</Text>
  <Box style={{ position: 'absolute', bottom: 26, left: 60 }}>
    <Text style={{ fontSize: 14, color: '#475569' }}>AgentBank · 智能体银行</Text>
  </Box>
  <Box style={{ position: 'absolute', bottom: 26, right: 60 }}>
    <Text style={{ fontSize: 14, color: '#475569' }}>16 / 18</Text>
  </Box>
</Slide>
